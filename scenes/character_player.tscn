[sub_resource type="GDScript" id="GDScript_etjlb"]
script/source = "extends Camera2D

# Declare custom variables for camera movement limits
var custom_limit_left : float = 0
var custom_limit_top : float = 0
var custom_limit_right : float = 320  # Set this to the background width
var custom_limit_bottom : float = 180  # Set this to the background height

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	# Enable position smoothing for the camera
	position_smoothing_enabled = true
	position_smoothing_speed = 5  # You can adjust this speed to your preference

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	# Apply camera limits to prevent it from going out of bounds
	var camera_position = position
	
	# Clamp the camera position to the defined limits
	camera_position.x = clamp(camera_position.x, custom_limit_left, custom_limit_right)
	camera_position.y = clamp(camera_position.y, custom_limit_top, custom_limit_bottom)

	# Update the camera position with the clamped value
	position = camera_position
"

